<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 引导页：使用 AndroidX AppCompat 主题，与 AppCompatActivity 一致。
         不继承 android:Theme.Material.*，避免 AppCompatActivity 报错要求窗口主题。 -->
    <style name="Theme.SpeedPing" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- 启动页 / 悬浮窗相关动画用，保底 -->
    <style name="Theme.SpeedPing.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>

